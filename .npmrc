@hugeicons-pro:registry=https://npm.hugeicons.com/
# The registry token is not kept here (pnpm ignores tokens in a project .npmrc).
# It lives in Doppler (photo-portfolio → HUGEICONS_TOKEN), Vercel and GitHub
# secrets, and install steps write it to pnpm's user config:
#   pnpm config set //npm.hugeicons.com/:_authToken "$HUGEICONS_TOKEN"
