# Anthropic API key. The agent calls Claude directly with it.
ANTHROPIC_API_KEY=
# Needed only when the key is not scoped to one workspace (Console → Workspaces).
ANTHROPIC_WORKSPACE_ID=

# Shared secret the web app sends as "Authorization: Bearer ...".
# Must match EVE_API_TOKEN in the web app.
EVE_API_TOKEN=

# Test account for apps behind a login. The log_in tool types these into the
# browser. The AI model never sees them. Use a read-only test account.
LOGIN_USER=
LOGIN_PASS=

# Required: trusted sign-in page. Stored credentials are only entered on this origin.
LOGIN_URL=https://app.example.com/login

# Optional: CSS selectors when the automatic field detection picks the wrong field.
# LOGIN_USER_SELECTOR=#email
# LOGIN_PASS_SELECTOR=#password
# LOGIN_SUBMIT_SELECTOR=button[type=submit]
